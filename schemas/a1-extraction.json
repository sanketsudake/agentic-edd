{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["scope_summary", "is_construction", "bom", "special_requirements", "missing_quantities"],
  "properties": {
    "scope_summary": { "type": "string", "minLength": 1 },
    "is_construction": { "type": "boolean" },
    "bom": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "description", "quantity", "unit", "source", "basis"],
        "properties": {
          "category": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "quantity": { "type": "number", "minimum": 0 },
          "unit": { "enum": ["sq_ft", "linear_ft", "cu_yd", "each"] },
          "source": { "enum": ["stated", "derived"] },
          "basis": { "type": "string", "minLength": 1 }
        }
      }
    },
    "special_requirements": { "type": "array", "items": { "type": "string" } },
    "missing_quantities": { "type": "array", "items": { "type": "string" } }
  }
}
