{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposal_markdown", "figures", "exclusions"],
  "properties": {
    "proposal_markdown": { "type": "string", "minLength": 200 },
    "figures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["materials", "labor", "overhead", "contingency", "final_bid"],
      "properties": {
        "materials": { "type": "number", "minimum": 0 },
        "labor": { "type": "number", "minimum": 0 },
        "overhead": { "type": "number", "minimum": 0 },
        "contingency": { "type": "number", "minimum": 0 },
        "final_bid": { "type": "number", "minimum": 0 }
      }
    },
    "exclusions": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string", "minLength": 1 } }
  }
}
