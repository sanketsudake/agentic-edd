{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["risk_factors", "contingency_rate", "contingency_reason", "flags"],
  "properties": {
    "risk_factors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["factor", "severity", "evidence"],
        "properties": {
          "factor": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["low", "medium", "high"] },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "contingency_rate": { "type": "number", "minimum": 0.10, "maximum": 0.25 },
    "contingency_reason": { "type": "string", "minLength": 1 },
    "flags": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["hazardous_material", "legal_clause", "schedule_constraint", "access_constraint", "unclear_scope"] }
    }
  }
}
