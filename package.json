{
  "name": "agentic-edd",
  "version": "0.1.0",
  "private": true,
  "description": "Bid pipeline: a construction RFP in, a priced and reviewed proposal out, from five evaluated prompts with code-enforced math and guardrails",
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "eval": "bash scripts/eval-agent.sh",
    "validate": "bash scripts/validate-agents.sh",
    "run": "node harness/run.js",
    "trace": "node harness/trace.js",
    "format": "prettier --write \"**/*.{js,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,yaml}\""
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "promptfoo": "^0.121.17"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
